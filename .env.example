# .env.example — copy ke .env untuk local dev, set di Vercel dashboard untuk production

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # bukan anon key, pakai service_role

# JWT — string random panjang, bisa generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_ini_dengan_string_random_panjang

# Password admin panel (plain text, dibandingkan langsung di /api/admin/login)
# Kalau mau lebih aman bisa hash bcrypt dan sesuaikan logika di admin.js
ADMIN_PASSWORD=ganti_password_admin_kamu
