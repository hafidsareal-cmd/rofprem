{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static",
      "config": {
        "exclude": ["api/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/admin/login",    "dest": "/api/admin.js" },
    { "src": "/api/admin/stats",    "dest": "/api/admin.js" },
    { "src": "/api/admin/codes",    "dest": "/api/admin.js" },
    { "src": "/api/admin/generate", "dest": "/api/admin.js" },
    { "src": "/api/admin/revoke",   "dest": "/api/admin.js" },
    { "src": "/api/admin/delete",   "dest": "/api/admin.js" },
    { "src": "/api/admin/download", "dest": "/api/admin.js" },
    { "src": "/api/auth",           "dest": "/api/auth.js"  },
    { "src": "/admin",              "dest": "/admin.html"   },
    { "src": "/",                   "dest": "/index.html"   },
    { "src": "/(.*)",               "dest": "/$1"           }
  ]
}
